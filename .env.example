# ---------------------------------------------------------------------------
# AegisFlow EHS - environment template.  Copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored. Never commit a real key.
# ---------------------------------------------------------------------------

# --- LLM provider ---------------------------------------------------------
# One of: groq | gemini | offline
# `offline` uses the deterministic rule-based parser and needs no key at all,
# so the whole pipeline runs with zero network access.
AEGISFLOW_LLM_PROVIDER=offline

# Groq (primary, free tier) -> https://console.groq.com/keys
GROQ_API_KEY=
# Model ids live here, not in code: Groq's catalogue changes and availability differs
# per account. Verify with `python -m aegisflow info --check-llm` before a demo.
# Text model - policy rule extraction.
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Vision model - reads the policy's observable indicators off a frame.
# Must be vision-capable; most Groq text models are not.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Google Gemini (optional alternate) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Detection engine -----------------------------------------------------
AEGISFLOW_YOLO_WEIGHTS=artifacts/models/yolov8n.pt
AEGISFLOW_DEVICE=cpu                 # cpu | cuda:0
AEGISFLOW_SAMPLE_FPS=4               # frames analysed per second of video
AEGISFLOW_INFER_IMGSZ=640            # YOLO input size (clips are 1920x1080)
AEGISFLOW_CONF_THRESHOLD=0.35
AEGISFLOW_VLM_TIEBREAK_BAND=0.15     # |margin| below this -> ask the VLM

# --- Persistence & API ----------------------------------------------------
AEGISFLOW_DB_URL=sqlite+aiosqlite:///./aegisflow.db
AEGISFLOW_API_HOST=127.0.0.1
AEGISFLOW_API_PORT=8000
AEGISFLOW_LOG_LEVEL=INFO
